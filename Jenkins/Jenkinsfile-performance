@Library('performance-lib') _

pipeline {
    agent any

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ISSUE_KEY',   value: '$.issue.key'],
                [key: 'SERVICE_URL', value: '$.issue.fields.customfield_10039'],
                [key: 'HTTP_METHOD', value: '$.issue.fields.customfield_10072.value'],
                [key: 'HEADERS',     value: '$.issue.fields.customfield_10073'],
                [key: 'BODY',        value: '$.issue.fields.customfield_10074'],
                [key: 'TEST_TYPE',   value: '$.issue.fields.customfield_10075.value'],
                [key: 'VUS',         value: '$.issue.fields.customfield_10076'],
                [key: 'DURATION',    value: '$.issue.fields.customfield_10077'],
            ],
            token: 'jira-performance',
            printContributedVariables: true,
            printPostContent: true
        )
    }

    parameters {
        string(name: 'SERVICE_URL', defaultValue: 'http://host.docker.internal:8000/health', description: 'URL del endpoint a probar')
        choice(name: 'METHOD',      choices: ['GET','POST','PUT','DELETE'], description: 'Método HTTP')
        string(name: 'HEADERS',     defaultValue: '{"Content-Type": "application/json"}', description: 'Headers JSON')
        string(name: 'BODY',        defaultValue: 'null', description: 'Body JSON')
        choice(name: 'TEST_TYPE',   choices: ['smoke','load','stress'], description: 'Tipo de prueba')
        string(name: 'VUS',         defaultValue: '5', description: 'Usuarios virtuales')
        string(name: 'DURATION',    defaultValue: '30s', description: 'Duración')
        string(name: 'EMAIL',       defaultValue: 'newprojectcv.1999@gmail.com', description: 'Correo')
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Bajando código de GitHub...'
                git branch: 'main', url: 'https://github.com/GhostNoc99/performance-on-demand.git'
            }
        }

        stage('Validar Parámetros') {
            steps {
                script {
                    def url      = env.SERVICE_URL
                    def method   = env.HTTP_METHOD_value ?: env.HTTP_METHOD ?: params.METHOD
                    def testType = env.TEST_TYPE_value   ?: env.TEST_TYPE   ?: params.TEST_TYPE
                    def vus      = env.VUS      ?: params.VUS
                    def duration = env.DURATION ?: params.DURATION
                    def issueKey = env.ISSUE_KEY ?: 'MANUAL'
                    def fecha      = new Date().format('yyyy-MM-dd_HH-mm')
                    def reportName = "${issueKey}_${testType}_${fecha}.html"
                    def reportPath = "k6/reports/${reportName}"

                    env.REPORT_NAME       = reportName
                    env.REPORT_PATH       = reportPath
                    env.METHOD_RESOLVED   = method
                    env.TESTTYPE_RESOLVED = testType

                    currentBuild.description = "🧪 ${testType.toUpperCase()} | ${method} | ${vus} VUs | ${duration} | ${issueKey}"

                    echo "🔍 Origen: ${issueKey == 'MANUAL' ? 'Manual' : 'Jira ' + issueKey}"
                    echo "URL:      ${url}"
                    echo "Método:   ${method}"
                    echo "Tipo:     ${testType}"
                    echo "VUs:      ${vus}"
                    echo "Duración: ${duration}"
                    echo "Reporte:  ${reportName}"

                    if (!url) error("❌ SERVICE_URL es requerido")

                    if (issueKey && issueKey != 'MANUAL') {
                        withCredentials([string(credentialsId: 'jira-api-token', variable: 'JIRA_TOKEN')]) {
                            jiraUtils.transition(issueKey, '2', JIRA_TOKEN)
                            jiraUtils.comment(issueKey, "🚀 Jenkins ha iniciado la prueba. Build #${env.BUILD_NUMBER} | Tipo: ${testType.toUpperCase()} | Método: ${method} | VUs: ${vus} | Duración: ${duration}", JIRA_TOKEN)
                        }
                        echo "🔄 Tarea ${issueKey} movida a En Ejecución"
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    def url = env.SERVICE_URL ?: params.SERVICE_URL
                    echo "🧪 Verificando que el servicio responde..."
                    def response = sh(
                        script: "curl -s -o /dev/null -w '%{http_code}' ${url}",
                        returnStdout: true
                    ).trim()
                    echo "Código de respuesta: ${response}"
                    if (response == "000") error("❌ El servicio no responde en ${url}")
                }
            }
        }

        stage('Ejecutar Prueba') {
            agent {
                docker {
                    image 'ghcr.io/ghostnoc99/k6-performance:latest'
                    args "--entrypoint='' --network host -v /var/jenkins_home/workspace/performance-on-demand/k6/reports:/k6/reports"
                    reuseNode true
                }
            }
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        k6Utils.run([
                            url:        env.SERVICE_URL,
                            method:     env.METHOD_RESOLVED,
                            headers:    env.HEADERS   ?: params.HEADERS,
                            body:       env.BODY       ?: params.BODY,
                            vus:        env.VUS        ?: params.VUS,
                            duration:   env.DURATION   ?: params.DURATION,
                            testType:   env.TESTTYPE_RESOLVED,
                            reportName: env.REPORT_NAME,
                            issueKey:   env.ISSUE_KEY  ?: 'MANUAL'
                        ])
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def jsonPath = env.REPORT_PATH.replace('.html', '.json')
                    k6Utils.qualityGate(env.TESTTYPE_RESOLVED, jsonPath)
                }
            }
        }

        stage('Publicar Reporte') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'SUCCESS') {
                    script {
                        echo "📊 Reporte generado: ${env.REPORT_NAME}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def status     = currentBuild.result ?: 'SUCCESS'
                def issueKey   = env.ISSUE_KEY   ?: 'MANUAL'
                def testType   = env.TESTTYPE_RESOLVED ?: params.TEST_TYPE ?: 'N/A'
                def url        = env.SERVICE_URL       ?: params.SERVICE_URL
                def method     = env.METHOD_RESOLVED   ?: params.METHOD
                def reportPath = env.REPORT_PATH       ?: 'k6/reports/dynamic-report.html'
                def reportName = env.REPORT_NAME       ?: 'dynamic-report.html'
                def jsonPath   = reportPath.replace('.html', '.json')
                def metrics    = k6Utils.parseMetrics(jsonPath)

                if (issueKey && issueKey != 'MANUAL') {
                    withCredentials([string(credentialsId: 'jira-api-token', variable: 'JIRA_TOKEN')]) {
                        jiraUtils.update([
                            issueKey:    issueKey,
                            status:      status,
                            reportPath:  reportPath,
                            reportName:  reportName,
                            buildNumber: env.BUILD_NUMBER,
                            token:       JIRA_TOKEN
                        ])
                        confluenceUtils.publish([
                            token:       JIRA_TOKEN,
                            issueKey:    issueKey,
                            testType:    testType,
                            buildNumber: env.BUILD_NUMBER,
                            status:      status,
                            reportName:  reportName,
                            metrics:     metrics
                        ])
                    }
                }

                if (fileExists(reportPath)) {
                    def emoji = status == 'SUCCESS' ? '✅' : '❌'
                    emailext(
                        to: params.EMAIL ?: 'newprojectcv.1999@gmail.com',
                        subject: "${emoji} Performance Report — ${testType.toUpperCase()} | ${method} ${url} | ${issueKey}",
                        body: """
                            <h2>${emoji} Reporte de Performance On-Demand</h2>
                            <table border='1' cellpadding='5'>
                                <tr><td><b>Jira Issue</b></td><td>${issueKey}</td></tr>
                                <tr><td><b>URL</b></td><td>${url}</td></tr>
                                <tr><td><b>Método</b></td><td>${method}</td></tr>
                                <tr><td><b>Tipo</b></td><td>${testType.toUpperCase()}</td></tr>
                                <tr><td><b>Estado</b></td><td>${status}</td></tr>
                                <tr><td><b>P95</b></td><td>${metrics.p95}</td></tr>
                                <tr><td><b>Error Rate</b></td><td>${metrics.errorRate}</td></tr>
                            </table>
                            <p>Reporte disponible en Confluence:
                            <a href="https://mi-ecosistema.atlassian.net/wiki/spaces/PERF">Performance Testing Space</a></p>
                        """,
                        attachmentsPattern: reportPath,
                        mimeType: 'text/html'
                    )
                }
            }
        }
        success { echo '🚀 Prueba completada exitosamente!' }
        failure { echo '❌ La prueba falló!' }
    }
}